---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { gacetaEntries } from '../../data/gaceta';
import { formatDate } from '../../lib/format';
---

<BaseLayout title="Gaceta Municipal" description="Publicaciones normativas y documentos oficiales.">
  <PageHero
    kicker="Transparencia normativa"
    title="Gaceta Municipal"
    subtitle="Consulte ordenanzas, reglamentos, resoluciones y convocatorias oficiales."
    image="/images/inka-raqay-muros.jpg"
  />

  <section class="container-page py-16">
    <ol>
      {
        gacetaEntries.map((entry) => (
          <li class="grid gap-4 border-t border-line py-8 md:grid-cols-[9rem_1fr_auto] md:items-baseline">
            <p class="font-mono text-xs tracking-wide text-adobe">{entry.number}</p>
            <div>
              <h2 class="display-md">{entry.title}</h2>
              <p class="mt-2 text-sm text-ink-soft">{formatDate(entry.publishedAt)}</p>
            </div>
            <a
              href={entry.pdfUrl}
              class="link-arrow"
            >
              Descargar
            </a>
          </li>
        ))
      }
    </ol>
    <div class="hairline"></div>
  </section>
</BaseLayout>
