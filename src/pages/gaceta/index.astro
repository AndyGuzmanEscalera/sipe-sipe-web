---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LiveGaceta from '../../components/LiveGaceta.astro';
---

<BaseLayout title="Gaceta Municipal" description="Publicaciones normativas y documentos oficiales.">
  <PageHero
    kicker="Transparencia normativa"
    title="Gaceta Municipal"
    subtitle="Consulte ordenanzas, reglamentos, resoluciones y convocatorias oficiales."
    image="/images/inka-raqay-muros.jpg"
  />

  <section class="container-page py-16">
    <LiveGaceta />
    <div class="hairline"></div>
  </section>
</BaseLayout>
