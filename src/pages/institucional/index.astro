---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LiveInstitutional from '../../components/LiveInstitutional.astro';
import LiveMayor from '../../components/LiveMayor.astro';
import LiveAuthorities from '../../components/LiveAuthorities.astro';
import { organizationalUnits } from '../../data/institucional';
---

<BaseLayout title="Institucional" description="Misión, visión, autoridades y estructura organizacional.">
  <PageHero
    kicker="Gobierno municipal"
    title="Conozca nuestra institución"
    subtitle="Misión, visión, principios y autoridades al servicio del municipio de Sipe Sipe."
    image="/images/iglesia-san-pedro-fachada.jpg"
  />

  <LiveInstitutional />

  <section class="container-page py-16">
    <LiveMayor variant="institutional" />
  </section>

  <LiveAuthorities />

  <section class="container-page pb-20">
    <p class="kicker">Estructura</p>
    <p class="mt-2 text-xs text-ink-soft/80">
      Unidades organizacionales: pendiente de administración desde Gestión (dato temporal en sitio).
    </p>
    <ol class="mt-8 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        organizationalUnits.map((unit, index) => (
          <li class="bg-paper px-5 py-6">
            <span class="font-mono text-xs text-ink-soft">{String(index + 1).padStart(2, '0')}</span>
            <p class="mt-2 text-lg">{unit}</p>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
