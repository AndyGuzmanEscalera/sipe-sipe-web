---
import type { NavItem } from '../types/content';

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<section class="section-lg bg-white pt-12 lg:pt-16">
  <div class="container-page">
    <div class="mb-12 max-w-2xl">
      <p class="kicker">Accesos rápidos</p>
      <h2 class="display-lg">Servicios e información</h2>
      <p class="mt-3 text-base text-ink-soft">
        Acceda de forma ágil a los servicios, documentos y trámites del municipio.
      </p>
    </div>

    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item, idx) => (
          <li>
            <a
              href={item.href}
              class="group flex h-full min-h-40 flex-col rounded-[1.75rem] bg-paper-deep p-6 transition duration-200 hover:-translate-y-1 hover:bg-white hover:shadow-[0_16px_36px_rgb(32_51_43/0.1)]"
            >
              <span
                class="mb-4 h-2.5 w-10 rounded-full"
                style={{ background: idx % 2 === 0 ? '#079447' : '#08a9dc' }}
              ></span>
              <span class="text-lg font-bold text-ink group-hover:text-forest">{item.label}</span>
              <span class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{item.description}</span>
              <span class="mt-5 text-sm font-semibold text-forest">Acceder →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
