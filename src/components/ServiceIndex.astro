---
import type { NavItem } from '../types/content';

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<section class="section-lg bg-white">
  <div class="container-page">
    <div class="mb-12">
      <p class="kicker">Accesos rápidos</p>
      <h2 class="display-lg">Servicios e información</h2>
      <p class="mt-3 max-w-2xl text-base text-ink-soft">
        Acceda de forma ágil a los servicios, documentos y trámites del municipio.
      </p>
    </div>

    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item, idx) => (
          <li class="service-item">
            <a
              href={item.href}
              class="surface-card group flex h-full min-h-36 flex-col border-l-4 p-6 transition duration-200"
              style={{
                borderLeftColor: idx % 2 === 0 ? '#079447' : '#08a9dc',
              }}
            >
              <span class="text-base font-bold text-ink group-hover:text-forest">{item.label}</span>
              <span class="mt-2 flex-1 text-sm text-ink-soft leading-relaxed">{item.description}</span>
              <span class="mt-4 text-xs font-semibold uppercase tracking-[0.08em] text-forest group-hover:text-forest-deep">
                Acceder →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .service-item:nth-child(odd) > a {
    border-left-color: #079447;
  }

  .service-item:nth-child(even) > a {
    border-left-color: #08a9dc;
  }

  .service-item:nth-child(even) > a > span:first-child,
  .service-item:nth-child(even) > a > span:last-child {
    color: #077fa8;
  }
</style>
