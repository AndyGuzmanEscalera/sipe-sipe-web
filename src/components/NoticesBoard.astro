---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { withBase } from '../lib/withBase';
import { notices } from '../data/notices';
import { gacetaEntries } from '../data/gaceta';

const dayOf = (iso: string) => iso.slice(8, 10);
const monthOf = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString('es-BO', { month: 'short' }).replace('.', '');
---

<section class="notices-board section-lg container-page">
  <SectionHeading
    kicker="Información oficial"
    title="Avisos y comunicados"
    description="Convocatorias, comunicados y normativa publicada por el Gobierno Municipal."
  />

  <div class="grid gap-6 lg:grid-cols-[1.3fr_1fr]">
    <ul class="grid gap-3">
      {
        notices.map((notice) => (
          <li>
            <a
              href={withBase(notice.href)}
              class="group flex items-center gap-4 rounded-[1.5rem] border border-line bg-white p-4 transition hover:border-forest/40 hover:shadow-[0_14px_30px_rgb(32_51_43/0.08)] md:p-5"
            >
              <span class="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-2xl bg-paper-deep text-forest group-hover:bg-forest group-hover:text-white">
                <span class="text-xl font-extrabold leading-none">{dayOf(notice.date)}</span>
                <span class="text-[0.65rem] font-bold uppercase tracking-wide">{monthOf(notice.date)}</span>
              </span>
              <span class="min-w-0 flex-1">
                <span class="text-xs font-bold uppercase tracking-[0.1em] text-adobe-deep">{notice.tag}</span>
                <span class="mt-0.5 block font-semibold leading-snug text-ink group-hover:text-forest">
                  {notice.title}
                </span>
              </span>
              <Icon name="arrow" class="hidden h-5 w-5 shrink-0 text-ink-soft transition group-hover:translate-x-1 group-hover:text-forest sm:block" />
            </a>
          </li>
        ))
      }
    </ul>

    <aside class="relative overflow-hidden rounded-[2rem] bg-forest-deep p-6 text-white md:p-8">
      <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-adobe/30 blur-2xl"></div>
      <div class="relative">
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white/10 text-maize">
          <Icon name="building" />
        </span>
        <h3 class="mt-4 text-2xl font-bold">Gaceta Municipal</h3>
        <p class="mt-1 text-sm text-white/75">Leyes, ordenanzas y reglamentos vigentes.</p>

        <ul class="mt-6 divide-y divide-white/10">
          {
            gacetaEntries.map((entry) => (
              <li class="py-3">
                <a href={withBase('/gaceta/')} class="group flex items-start gap-3">
                  <Icon name="document" class="mt-0.5 h-5 w-5 shrink-0 text-maize" />
                  <span>
                    <span class="block text-xs font-semibold text-maize/90">{entry.number}</span>
                    <span class="block text-sm font-medium leading-snug group-hover:underline">{entry.title}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <a
          href={withBase('/gaceta/')}
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-forest-deep transition hover:bg-maize"
        >
          Ver toda la gaceta
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </aside>
  </div>
</section>
