---
import type { NewsArticle } from '../types/content';
import NewsCard from './NewsCard.astro';
import SectionHeading from './SectionHeading.astro';
import { withBase } from '../lib/withBase';

interface Props {
  articles: NewsArticle[];
}

const { articles } = Astro.props;
const [featured, ...rest] = articles;
---

<section class="news-featured section-lg container-page">
  <SectionHeading
    kicker="Información"
    title="Noticias municipales"
    description="Avances, programas y actividades del Gobierno Municipal de Sipe Sipe."
    href="/noticias/"
    linkLabel="Todas las notas"
  />
  {
    featured && (
      <div class="grid gap-8 lg:grid-cols-[1.4fr_0.7fr]">
        <NewsCard article={featured} featured />
        <div class="surface-card flex flex-col divide-y divide-line overflow-hidden">
          {rest.map((article) => (
            <a href={withBase(`/noticias/${article.slug}/`)} class="flex gap-4 px-5 py-4 transition hover:bg-paper-deep">
              <img
                src={withBase(article.coverImage)}
                alt=""
                class="h-16 w-16 shrink-0 rounded-full object-cover"
                loading="lazy"
              />
              <div class="min-w-0">
                <p class="kicker mb-1 text-xs">{article.category}</p>
                <h3 class="text-sm font-bold leading-snug text-ink hover:text-forest">
                  {article.title}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    )
  }
</section>
