---
import { site } from '../data/site';
import { withBase } from '../lib/withBase';
---

<div class="bg-forest-deep text-[0.74rem] text-white">
  <div class="container-page flex flex-col gap-2 py-2 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-medium">
      Atención ciudadana: {site.hours}
    </p>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
      {
        site.topLinks.map((link) => (
          <a href={link.href} class="opacity-80 hover:opacity-100">
            {link.label}
          </a>
        ))
      }
      <a href={withBase('/contacto/')} class="font-bold text-white underline decoration-white/40 underline-offset-4">Contacto y ubicación</a>
    </div>
  </div>
</div>
