---
import type { MunicipalEvent } from '../types/content';
import { withBase } from '../lib/withBase';
import { formatDay, formatMonth, formatDateTime } from '../lib/format';

interface Props {
  event: MunicipalEvent;
}

const { event } = Astro.props;
---

<article class="flex gap-4 rounded-[1.75rem] bg-white p-4 shadow-[0_10px_30px_rgb(32_51_43/0.06)] md:gap-5 md:p-5">
  <div class="relative h-24 w-24 shrink-0 overflow-hidden rounded-full md:h-28 md:w-28">
    <img src={withBase(event.image)} alt="" class="h-full w-full object-cover" loading="lazy" />
    <div class="absolute inset-0 flex flex-col items-center justify-center bg-forest-deep/55 text-center text-white">
      <p class="text-2xl font-bold leading-none">{formatDay(event.startsAt)}</p>
      <p class="mt-1 text-[0.65rem] font-semibold uppercase tracking-[0.12em]">{formatMonth(event.startsAt)}</p>
    </div>
  </div>
  <div class="flex min-w-0 flex-col justify-center py-1">
    <h3 class="text-base font-bold leading-snug text-ink md:text-lg">{event.title}</h3>
    <p class="mt-2 text-sm text-ink-soft">{event.description}</p>
    <p class="mt-2 text-xs font-medium uppercase tracking-[0.08em] text-ink-soft">
      {formatDateTime(event.startsAt)} · {event.location}
    </p>
  </div>
</article>
