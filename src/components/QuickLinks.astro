---
import type { NavItem } from '../types/content';

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<section class="container-page -mt-10 relative z-10">
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item) => (
        <a
          href={item.href}
          class="card-hover rounded-xl border border-slate-200 bg-white p-5 shadow-md"
        >
          <h3 class="text-lg font-bold text-brand-800">{item.label}</h3>
          {item.description && <p class="mt-2 text-sm text-slate-600">{item.description}</p>}
          <span class="mt-4 inline-block text-sm font-semibold text-accent-600">Ingresar →</span>
        </a>
      ))
    }
  </div>
</section>
